# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://pub-ccb909d9c0d644b5bf1f9f2b769e9365.r2.dev https://*.airtableusercontent.com; connect-src 'self' https://cloudflareinsights.com https://api.whgemachs.org https://wh-gemach.barry253-0f5.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Admin uses Google Identity Services (inline code, accounts.google.com scripts/frames) — no site CSP here
/admin*
  ! Content-Security-Policy
  Cache-Control: no-store

# embed.html is designed to be iframed on other sites
/embed*
  ! Content-Security-Policy
  ! X-Frame-Options

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Borrower manage links carry a private token in the URL: never send it on as a referrer, never index or cache
/r/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/manage*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
