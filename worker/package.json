{
  "name": "wh-gemach-worker",
  "private": true,
  "type": "module",
  "description": "Gemach Network API (Cloudflare Worker) for whgemachs.org",
  "scripts": {
    "test": "node test/worker.test.mjs && node --no-warnings test/run-d1.mjs",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "schema": "node -e \"import('./src/dbschema.js').then(m => process.stdout.write(m.schemaSql()))\" > schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
